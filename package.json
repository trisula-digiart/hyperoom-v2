{
  "name": "hyperoom-v2",
  "private": true,
  "version": "0.2.0",
  "description": "Hyperoom v2 — self-hosted, Supabase-free, mIRC-inspired modern chat. PWA + Node backend + local PostgreSQL.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w @hyperoom/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "migrate": "node scripts/run-migrations.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
